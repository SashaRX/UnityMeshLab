+        sealed class BudgetChoice
+        {
+            internal Mesh mesh;
+            internal int triangles;
+            internal float cost;
+        }
+
+        // One source-derived alternative to uniform submesh reduction. A small
+        // dynamic program spends the same total budget on disconnected parts,
+        // using each part's screen footprint and silhouette rather than its
+        // tessellation density. Only sub-two-pixel parts may disappear entirely.
+        internal static Mesh AllocateScreenBudget(Mesh source,int budget,int pixels,MeshSimplifier.SimplifySettings settings,
+            out string note,Func<bool> cancelled = null)
+        {
+            note = null;
+            if (!source || source.vertexCount == 0 || budget < 1 || budget > 512 || pixels < 1 || pixels > 128 || settings.lockBorder ||
+                source.blendShapeCount > 0 || source.HasVertexAttribute(VertexAttribute.BlendWeight) || source.bindposes.Length > 0) return null;
+            var analysis = AnalyzeTriangles(source,cancelled);
+            if (analysis.parts.Length < 2 || analysis.parts.Length > 64) return null;
+            float extent = Mathf.Max(source.bounds.size.x,Mathf.Max(source.bounds.size.y,source.bounds.size.z));
+            var choices = new List<BudgetChoice>[analysis.parts.Length];
+            var owned = new List<Mesh>();
+            try
+            {
+                for (int p = 0; p < choices.Length; p++)
+                {
+                    if (cancelled?.Invoke() == true) throw new OperationCanceledException();
+                    var part = analysis.parts[p];
+                    var faces = part.faces.Select(f => analysis.source.faces[f]).ToList();
+                    var mesh = analysis.source.data.CreateMesh(faces,out _,ensureChannels:false); owned.Add(mesh);
+                    float diameter = Mathf.Max(part.bounds.size.x,Mathf.Max(part.bounds.size.y,part.bounds.size.z));
+                    int footprint = Mathf.Clamp(Mathf.CeilToInt(diameter/Mathf.Max(extent,1e-8f)*pixels),1,pixels);
+                    float weight = Mathf.Pow((float)footprint/pixels,2);
+                    var guide = new LodScreenValidation(mesh,false,cancelled,resolution:Mathf.Max(32,footprint+8),objectPixels:footprint,measureFields:true,allSides:true);
+                    choices[p] = new List<BudgetChoice>();
+                    if (diameter/Mathf.Max(extent,1e-8f)*pixels <= 2)
+                        choices[p].Add(new BudgetChoice { cost = weight*2 });
+                    foreach (int count in new[] { 2,4,6,8,12,16 })
+                    {
+                        if (count > budget) break;
+                        var attempt = settings; attempt.targetRatio = Mathf.Min(1,(float)count/part.triangles);
+                        attempt.targetError = 1; attempt.allowAttributeSeamCollapse = true;
+                        attempt.preserveHardEdges = attempt.nativeHardEdgeConstraints = false;
+                        attempt.normalWeight = attempt.uv2Weight = attempt.colorWeight = 0;
+                        var candidate = MeshSimplifier.Simplify(mesh,attempt);
+                        if (candidate.simplifiedMesh) owned.Add(candidate.simplifiedMesh);
+                        if (!candidate.ok || candidate.simplifiedTriCount < 1 || candidate.simplifiedTriCount > budget ||
+                            choices[p].Any(c => c.triangles == candidate.simplifiedTriCount)) continue;
+                        var measured = guide.Measure(candidate.simplifiedMesh,cancelled);
+                        choices[p].Add(new BudgetChoice { mesh = candidate.simplifiedMesh,triangles = candidate.simplifiedTriCount,
+                            cost = weight*(measured.silhouetteMean+measured.silhouetteMax) });
+                    }
+                    if (choices[p].Count == 0) { note = "Component floor exceeds the available budget; retained global candidate."; return null; }
+                }
+                var costs = new float[budget+1]; for (int b = 1; b <= budget; b++) costs[b] = float.PositiveInfinity;
+                var trace = new int[choices.Length,budget+1];
+                for (int p = 0; p < choices.Length; p++)
+                {
+                    if (cancelled?.Invoke() == true) throw new OperationCanceledException();
+                    var next = Enumerable.Repeat(float.PositiveInfinity,budget+1).ToArray();
+                    for (int b = 0; b <= budget; b++) trace[p,b] = -1;
+                    for (int b = 0; b <= budget; b++)
+                        for (int c = 0; c < choices[p].Count; c++)
+                        {
+                            var choice = choices[p][c]; int n = b+choice.triangles;
+                            if (n > budget || costs[b]+choice.cost >= next[n]) continue;
+                            next[n] = costs[b]+choice.cost; trace[p,n] = c;
+                        }
+                    costs = next;
+                }
+                int total = 0;
+                for (int b = 1; b <= budget; b++) if (costs[b] <= costs[total]) total = b;
+                if (float.IsInfinity(costs[total])) { note = "Combined component floors exceed the budget; retained global candidate."; return null; }
+                var selected = new BudgetChoice[choices.Length]; int remaining = total;
+                for (int p = choices.Length-1; p >= 0; p--)
+                {
+                    selected[p] = choices[p][trace[p,remaining]]; remaining -= selected[p].triangles;
+                }
+                // Assemble without welding separate components or changing slots.
+                var positions = new List<Vector3>(); var normals = new List<Vector3>(); var tangents = new List<Vector4>(); var colors = new List<Color>();
+                var uvs = new List<Vector4>[8]; for (int ch = 0; ch < 8; ch++) uvs[ch] = new List<Vector4>();
+                var slots = new List<int>[source.subMeshCount]; for (int s = 0; s < slots.Length; s++) slots[s] = new List<int>();
+                foreach (var choice in selected)
+                {
+                    if (!choice.mesh) continue;
+                    var data = new LodMeshData(choice.mesh); int offset = positions.Count;
+                    positions.AddRange(data.positions); normals.AddRange(data.normals); tangents.AddRange(data.tangents); colors.AddRange(data.colors);
+                    for (int ch = 0; ch < 8; ch++) if (data.uvs[ch] != null) uvs[ch].AddRange(data.uvs[ch]);
+                    for (int s = 0; s < slots.Length; s++) slots[s].AddRange(LodMeshData.Triangles(choice.mesh,s).Select(v => v+offset));
+                }
+                if (positions.Count == 0) return null;
+                var result = new Mesh { name = source.name,indexFormat = source.indexFormat }; owned.Add(result);
+                result.SetVertices(positions);
+                if (normals.Count == positions.Count) result.SetNormals(normals);
+                if (tangents.Count == positions.Count) result.SetTangents(tangents);
+                if (colors.Count == positions.Count)
+                {
+                    if (source.GetVertexAttributeFormat(VertexAttribute.Color) == VertexAttributeFormat.UNorm8) result.SetColors(colors.ConvertAll(c => (Color32)c));
+                    else result.SetColors(colors);
+                }
+                for (int ch = 0; ch < 8; ch++) if (uvs[ch].Count == positions.Count)
+                {
+                    int dimension = analysis.source.data.uvDimensions[ch];
+                    if (dimension == 2) result.SetUVs(ch,uvs[ch].ConvertAll(v => (Vector2)v));
+                    else if (dimension == 3) result.SetUVs(ch,uvs[ch].ConvertAll(v => (Vector3)v));
+                    else result.SetUVs(ch,uvs[ch]);
+                }
+                result.subMeshCount = slots.Length;
+                for (int s = 0; s < slots.Length; s++) result.SetTriangles(slots[s],s);
+                result.RecalculateBounds(); MeshUvState.SetDraft(result,MeshUvState.IsDraft(source));
+                note = $"Source component allocation: {choices.Length} parts, {total}/{budget} triangles; allocations [{string.Join(",",selected.Select(c => c.triangles))}].";
+                owned.Remove(result); return result;
+            }
+            finally { foreach (var mesh in owned) if (mesh) UnityEngine.Object.DestroyImmediate(mesh); }
+        }
